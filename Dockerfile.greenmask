FROM python:3.11-slim

# Install MySQL client for mysqldump operations
RUN apt-get update && apt-get install -y \
    mysql-client \
    gzip \
    && rm -rf /var/lib/apt/lists/*

# Install Greenmask via pip
RUN pip install --no-cache-dir greenmask PyYAML requests

# Set working directory
WORKDIR /app

# Copy custom transformer
COPY transformers/llm_masker.py /app/transformers/
COPY prompt_templates/*.txt /app/prompt_templates/

# Default command
CMD ["bash"]
