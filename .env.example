# =============================================================================
# MySQL Database Sanitizer - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# --- LLM API Configuration (Ofox AI / Qwen models) ---
# These settings are used by the custom transformer for data anonymization
OFOX_API_KEY=sk-your-api-key-here       # Required! Get from ofox.ai
LLM_MODEL=bailian/qwen3.5-flash         # Optional: bailian/qwen3.5-flash, bailian/qwen3-coder-next
LLM_ENDPOINT=https://api.ofox.ai/v1     # Optional
LLM_MAX_TOKENS=100                      # Optional: max tokens in response
LLM_TEMPERATURE=0.7                     # Optional: randomness (0-2)

# --- MySQL Database Connection ---
# Only required if running Greenmask directly against live database
# Not needed for dump-based workflow (dump.sql → sanitized.sql.gz)
DB_HOST=localhost                       # Production DB host
DB_PORT=3306                            # Optional: port
DB_USER=root                            # Optional: user
DB_PASSWORD=your_password_here          # Optional: password  
DB_NAME=your_database                   # Optional: database name
