# MySQL Database Sanitizer - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# LLM API Configuration (required)
# =============================================================================
# API key for Ofox AI (Qwen models)
OFOX_API_KEY=sk-your-api-key-here

# Optional overrides (defaults shown below)
LLM_ENDPOINT=https://api.ofox.ai/v1
LLM_MODEL=bailian/qwen3.5-flash
LLM_MAX_TOKENS=100
LLM_TEMPERATURE=0.7

# =============================================================================
# Database Connection (optional - only if Greenmask connects directly to DB)
# =============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=your_database
